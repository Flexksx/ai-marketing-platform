{
  "cSpell.words": [
    "Blackbox",
    "buzzowords",
    "cloudtasks",
    "Copywrite",
    "dataclass",
    "fastapi",
    "modulith",
    "onlyness",
    "overcomplicate",
    "overengineer",
    "Paraben",
    "Paraglide",
    "psychographic",
    "pycache",
    "pydantic",
    "pythonpath",
    "shadcn",
    "supabase",
    "venv",
    "voisso"
  ],
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.svelte-kit/**": true,
    "**/build/**": true,
    "**/dist/**": true
  },
  "search.exclude": {
    "**/node_modules/**": true,
    "**/.svelte-kit/**": true,
    "**/build/**": true,
    "**/dist/**": true
  },
  "files.exclude": {
    "**/node_modules/**": true,
    "**/.svelte-kit/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/.venv/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.direnv/**": true
  },
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.ruff": "explicit",
    "source.organizeImports.ruff": "explicit",
    "source.fixAll.eslint": "explicit",
    "source.sortImports": "explicit"
  },
  // ESLint - Linter
  "eslint.validate": [
    "javascript",
    "typescript",
    "svelte"
  ],
  // Svelte
  "svelte.plugin.svelte.enable": true,
  "svelte.plugin.svelte.compilerWarnings": true,
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "always"
    }
  },
  // TSGO - TS LSP
  "typescript.experimental.useTsgo": false,
  // Python settings
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // Ruff - python formatter
  "ruff.interpreter": [
    "${workspaceFolder}/.venv/bin/python"
  ],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  // Python LSP settings with ty
  "python.languageServer": "None",
  "ty.completions.autoImport": true,
  "ty.importStrategy": "fromEnvironment",
  "ty.inlayHints.variableTypes": true,
  "ty.inlayHints.callArgumentNames": true,
  "ty.interpreter": [
    "${workspaceFolder}/.venv/bin/python"
  ],
  "ty.diagnosticMode": "workspace"
}