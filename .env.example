# Copy this file to .env and fill in values for your environment.
# Local docker-compose dev defaults are pre-filled where safe to do so.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Local dev uses well-known Supabase demo keys.
# The anon/service keys are JWTs signed with SUPABASE_JWT_SECRET.
# Replace all three when targeting a cloud Supabase project.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
PUBLIC_SUPABASE_URL=http://localhost:8000
PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.6kKsos8NBDW6XLNsnVYMeChFRvbsEedS7lUGEC3MSp4
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.DOkTK-lBVH-fhw6M0zelnjU2M4OpSk48hJiaVIf2u8M

# ── Database ──────────────────────────────────────────────────────────────────
# Password for the Supabase postgres superuser and all internal service roles.
DB_PASSWORD=postgres

# ── URLs ──────────────────────────────────────────────────────────────────────
# SPA_URL: where GoTrue redirects users after auth flows (email confirm, password reset).
SPA_URL=http://localhost:5173
# PUBLIC_BACKEND_URL: base URL the SPA uses to reach the API container.
PUBLIC_BACKEND_URL=http://localhost:8080

# ── AI / external APIs ────────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_CLOUD_SERVICES_API_KEY=
GOOGLE_CLOUD_PROJECT=local-dev
GOOGLE_CLOUD_LOCATION=global
PIXABAY_API_KEY=
